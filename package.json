{
  "name": "stock-watcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Surveillance de disponibilite/remise en vente d'articles sur plusieurs sites, avec alertes Telegram.",
  "scripts": {
    "check": "node src/index.js",
    "check:dry": "node src/index.js --dry-run",
    "check:verbose": "node src/index.js --verbose",
    "test-alert": "node src/index.js --test-alert",
    "browsers": "playwright install --with-deps chromium",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.49.0",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
